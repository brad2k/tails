---
import { Font } from "astro:assets";
import Header from "../components/header.astro";
import "../styles/imports.css";

interface Props {
  className?: string;
  pageDescription: string;
  pageTitle?: string;
}

const { className, pageDescription, pageTitle = "Tails" } = Astro.props;

const canonical = new URL(Astro.url.pathname.replace(/\/?$/, "/"), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <script>
      (function () {
        try {
          var theme = localStorage.getItem("theme") || "system";
          var resolved =
            theme === "system"
              ? window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light"
              : theme;
          var root = document.documentElement;
          root.setAttribute("data-theme", resolved);
        } catch (e) {}
      })();
    </script>

    <meta charset="UTF-8" />
    <meta name="color-scheme" content="light dark" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-DMSans" />
    <Font cssVariable="--font-ClimateCrisis" />
    <Font cssVariable="--font-Fraunces" />
    <slot name="head" />
  </head>
  <body>
    <div class="content">
      <Header />
      <main class:list={[className]}>
        <slot />
      </main>
    </div>
  </body>
</html>

<style>
  .content {
    --padding-block-end: var(--space-3xl);
    --padding-block-start: var(--space-s);
    --padding-inline: var(--space-s);

    min-block-size: calc(100% - var(--space-s) - var(--space-3xl));
    padding-block-start: var(--padding-block-start);
    padding-block-end: var(--padding-block-end);
    padding-inline: var(--padding-inline);
  }
</style>
