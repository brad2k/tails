---
import { Font } from "astro:assets";
import Header from "../components/header.astro";
import { CupSoda, Martini, Wine } from "@lucide/astro";
import "../styles/imports.css";

interface Props {
  className?: string;
  pageDescription: string;
  pageTitle?: string;
}

const { className, pageDescription, pageTitle = "Tails" } = Astro.props;

const canonical = new URL(Astro.url.pathname.replace(/\/?$/, "/"), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="color-scheme" content="light dark" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-DMSans" />
    <Font cssVariable="--font-ClimateCrisis" preload />
    <Font cssVariable="--font-Fraunces" preload />
    <slot name="head" />
  </head>
  <body>
    <div class="content">
      <Header />
      <main class:list={[className]}>
        <slot />
      </main>
      <footer class="flow">
        <Martini width={36} height={36} stroke="var(--color-border)" />
        <Wine width={36} height={36} stroke="var(--color-border)" />
        <CupSoda width={36} height={36} stroke="var(--color-border)" />
        <p>
          A goofy little thing made by <a
            href="https://www.bradazevedo.com/"
            rel="external noopener">Brad Azevedo</a
          >
        </p>
      </footer>
    </div>
  </body>
</html>

<style>
  .content {
    --padding-block-end: var(--space-s);
    --padding-block-start: var(--space-s);
    --padding-inline: var(--space-s);

    min-block-size: calc(100% - var(--space-s) - var(--space-3xl));
    padding-block-start: var(--padding-block-start);
    padding-block-end: var(--padding-block-end);
    padding-inline: var(--padding-inline);
  }

  footer {
    margin-block-start: var(--space-4xl);
    font-size: var(--font-size-subtle);
    text-align: center;
  }
</style>
