---
import { ArrowRight } from "@lucide/astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { ROLLUP_CATEGORIES } from "../content/categories";
import Layout from "../layouts/Layout.astro";

const cocktails = await getCollection("cocktails");
---

<script src="../scripts/recipes.ts"></script>

<Layout pageTitle="Tails — cocktail library" pageDescription="Cocktail recipes">
  <section class="recipe-grid">
    <header class="hero flow">
      <h1>Cocktail recipes</h1>
      <h2>What are you in the mood for?</h2>
      <p>
        I have{` `}<span class="pill">{cocktails.length} recipes</span>{` `}on
        offer.
      </p>
    </header>

    <nav class="category-nav">
      <ul class="categories">
        <li class="category">
          <button data-category="">Everything</button>
        </li>
        {
          ROLLUP_CATEGORIES.map(({ label, value }) => (
            <li class="category">
              <button data-category={value}>{label}</button>
            </li>
          ))
        }
      </ul>
    </nav>

    <ul class="recipes grid">
      {
        cocktails.map((cocktail, index) => (
          <li class="recipe" data-category={cocktail.data.category.join(" ")}>
            {cocktail.data.image && (
              <a href={`/cocktails/${cocktail.id}`}>
                <Image
                  src={cocktail.data.image}
                  alt={cocktail.data.name}
                  width={600}
                  height={400}
                  priority={index < 3}
                />
              </a>
            )}
            <div class="flow">
              <strong>{cocktail.data.category.join(" / ")}</strong>
              <a href={`/cocktails/${cocktail.id}`} class="name">
                <>
                  <span>{cocktail.data.name}</span>
                  <ArrowRight />
                </>
              </a>
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>

