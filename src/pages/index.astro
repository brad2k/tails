  .category-nav {
    margin-block-end: var(--space-l);
    border-radius: 999px;
    border: 1px solid var(--color-border);
    inline-size: fit-content;
    max-inline-size: 100%;
    margin-inline: auto;
    overflow: hidden;
    padding: 2px;
  }

  .categories {
    display: flex;
    gap: var(--space-xs);
    inline-size: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    white-space: nowrap;
    animation: toggle-scroll-fade linear;
    animation-timeline: scroll(self inline);

    &::-webkit-scrollbar {
      display: none;
    }
  }

  .category {
    flex: 0 0 auto;
    scroll-snap-align: start;

    button {
      font-size: var(--font-size-small);
      text-transform: uppercase;
      font-weight: var(--font-weight-normal);
      letter-spacing: 0.1em;
      border: 1px solid transparent;
      border-radius: 9999px;
      padding-block: var(--space-xs);
      padding-inline: var(--space-s);
      transition: background-color var(--transition-base);

      &[aria-pressed="true"],
      &:hover {
        border-color: var(--color-border);
        background-color: var(--color-ocean);
      }
    }
  }

  @keyframes toggle-scroll-fade {
    /* At scroll start: only fade the right edge */
    0% {
      mask-image: linear-gradient(
        to right,
        black calc(100% - 3rem),
        transparent
      );
    }
    /* In the middle: fade both left and right edges */
    10%,
    90% {
      mask-image: linear-gradient(
        to right,
        transparent,
        black 3rem,
        black calc(100% - 3rem),
        transparent
      );
    }
    /* At scroll end: only fade the left edge */
    100% {
      mask-image: linear-gradient(
        to right,
        transparent,
        black 3rem,
        black 100%
      );
    }
  }

  .recipe-grid {
    max-inline-size: var(--prose-max-width);
    margin-block: 0;
    margin-inline: auto;
    container-type: inline-size;
    container-name: recipe-grid;
  }

  .recipes {
    --gutter: var(--space-s);
    --grid-min-item-size: 1fr;
    row-gap: var(--space-2xl);
    transition: gap var(--transition-base);

    @container recipe-grid (min-inline-size: 17rem) {
      --grid-min-item-size: 16rem;
    }

    @container recipe-grid (min-inline-size: 39rem) {
      --gutter: var(--space-xl);
    }
  }

  .recipe {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    min-inline-size: 0;
    opacity: 1;
    scale: 1;

    @media (prefers-reduced-motion: no-preference) {
      transition:
        opacity var(--transition-base),
        scale var(--transition-base),
        display var(--transition-base) allow-discrete;

      @starting-style {
        opacity: 0;
        scale: 0.95;
      }
    }

    &[hidden] {
      display: none;
      opacity: 0;
      scale: 0.95;
    }

    img {
      display: block;
      aspect-ratio: 16 / 9;
      border-radius: 1rem;
    }

    strong {
      display: block;
      text-transform: uppercase;
      font-size: var(--font-size-extra-small);
      font-weight: var(--font-weight-normal);
      letter-spacing: 0.15em;
      border-block-end: 1px solid var(--color-border);
      padding-block-end: 2px;
    }

    > .flow {
      --flow-space: var(--space-s);
      padding-block: 0;
      padding-inline: var(--space-xs);
    }

    .name {
      font-size: var(--font-size-h5);
      line-height: var(--leading-fine);
      font-weight: var(--font-weight-medium);
      letter-spacing: -0.01em;
      display: flex;
      justify-content: space-between;

      svg {
        flex-shrink: 0;
        transition: transform var(--transition-base);
      }

      @media (hover: hover) {
        &:hover {
          svg {
            transform: translateX(calc(var(--space-xs) * -1));
          }
        }
      }
    }
  }

  .hero {
    margin-block: var(--space-3xl);
    text-align: center;
    font-size: var(--font-size-base);

    h1 {
      text-transform: uppercase;
      font-family: var(--font-body);
      font-size: var(--font-size-small);
      font-weight: var(--font-weight-medium);
      letter-spacing: 0.1em;
    }

    h2 {
      font-size: var(--font-size-h1);
      text-shadow: var(--color-ocean) 1px 0 1px;
    }
  }
</style>
