    amount: '1'
    unit: oz
    garnish: false
  - type: Lillet Blanc
    amount: '1'
    unit: oz
    garnish: false
  - type: Orange liqueur
    amount: 3/4
    unit: oz
    garnish: false
  - type: 'Lemon juice '
    amount: 3/4
    unit: oz
    garnish: false
  - type: Simple syrup
    amount: 1/4
    unit: oz
    garnish: false
  - type: Absinthe
    amount: 1/8
    unit: tsp
